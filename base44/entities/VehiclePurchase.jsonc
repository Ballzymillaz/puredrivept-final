{
  "name": "VehiclePurchase",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Brand Model - Plate"
    },
    "base_price": {
      "type": "number",
      "description": "Market price of vehicle"
    },
    "total_price": {
      "type": "number",
      "description": "Market price + 25%"
    },
    "duration_months": {
      "type": "number",
      "description": "Payment duration in months"
    },
    "weekly_installment": {
      "type": "number",
      "description": "Weekly payment amount"
    },
    "remaining_balance": {
      "type": "number"
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "prepayment_amount": {
      "type": "number",
      "default": 0,
      "description": "Paiement anticip\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "active",
        "completed",
        "rejected",
        "cancelled"
      ],
      "default": "requested"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "approved_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "vehicle_id",
    "base_price",
    "duration_months"
  ]
}