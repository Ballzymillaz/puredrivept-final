{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Conversation/channel ID"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID (email)"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user emails who read"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "content"
  ]
}